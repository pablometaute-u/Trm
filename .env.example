# ============================================================
# MCP ABAP configuration example for TRM (QAS/PUP)
# Copy this file to .env and replace values marked as placeholders.
# ============================================================

# --- Connection target (QAS - PURO POLLO / PUP) ---
SAP_HOST=10.11.248.5
SAP_PORT=8000
SAP_CLIENT=00
SAP_SYSTEM=PUP
SAP_ROUTER=/H/190.145.112.71/S/3299

# --- Authentication ---
# AUTH_METHOD supports: auto | password | certificate
AUTH_METHOD=password
SAP_USERNAME=YOUR_SAP_USERNAME
SAP_PASSWORD=YOUR_SAP_PASSWORD

# --- Optional certificate auth (if AUTH_METHOD=certificate) ---
# PFX_PATH=./certs/sap.pfx
# PFX_PASSPHRASE=YOUR_CERTIFICATE_PASSPHRASE

# --- Optional runtime flags ---
# HEADFUL=true
# MFA_TIMEOUT=120000
